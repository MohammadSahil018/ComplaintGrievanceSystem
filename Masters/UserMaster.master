<%@ Master Language="C#" AutoEventWireup="true" CodeFile="UserMaster.master.cs" Inherits="Masters_UserMaster" %>

<!DOCTYPE html>
<html>
<head id="Head1" runat="server">
    <title>Citizen Portal | Smart Grievance</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="../Styles/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="form1" runat="server">
        <aside class="sidebar user">
            <h2><i class="fas fa-citizen"></i> CITIZEN PORTAL</h2>
            
            <asp:HyperLink ID="lnkDash" NavigateUrl="~/User/Dashboard.aspx" CssClass="nav-link" runat="server">
                <i class="fas fa-home"></i> Dashboard
            </asp:HyperLink>
            
            <asp:HyperLink ID="lnkSubmit" NavigateUrl="~/User/SubmitComplaint.aspx" CssClass="nav-link" runat="server">
                <i class="fas fa-pen-fancy"></i> Lodge Grievance
            </asp:HyperLink>
            
            <asp:HyperLink ID="lnkMy" NavigateUrl="~/User/MyComplaints.aspx" CssClass="nav-link" runat="server">
                <i class="fas fa-clipboard-list"></i> My Complaints
            </asp:HyperLink>

            <asp:HyperLink ID="HyperLink1" NavigateUrl="~/User/Profile.aspx" CssClass="nav-link" runat="server">
                <i class="fas fa-user"></i> My Profile
            </asp:HyperLink>

            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                <asp:HyperLink ID="lnkLogout" NavigateUrl="~/Logout.aspx" CssClass="nav-link" runat="server" style="color:#fda4af">
                    <i class="fas fa-power-off"></i> Logout
                </asp:HyperLink>
            </div>
        </aside>

        <main class="main-wrapper">
            <header class="top-bar">
                <div>
                    <h1 style="font-size: 1.4rem; margin: 0; color: var(--primary);">Citizen Services</h1>
                    <small style="color: var(--text-muted);">Public Grievance Redressal System</small>
                </div>
                <div class="user-badge" style="background: #e0f2fe; color: #0369a1; padding: 8px 16px; border-radius: 20px; font-weight: 600; font-size: 0.85rem;">
                    <i class="fas fa-user-circle"></i> Registered Citizen
                </div>
                
            </header>
            
            <div class="content-card">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
            
            <footer style="margin-top: 2rem; text-align: center; color: #94a3b8; font-size: 0.8rem;">
                &copy; <%: DateTime.Now.Year %> Government Grievance Portal. All Rights Reserved.
            </footer>
        </main>
    </form>
</body>
</html>