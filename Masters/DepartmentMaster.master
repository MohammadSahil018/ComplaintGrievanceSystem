<%@ Master Language="C#" AutoEventWireup="true" CodeFile="DepartmentMaster.master.cs" Inherits="Masters_DepartmentMaster" %>

<!DOCTYPE html>
<html>
<head id="Head1" runat="server">
    <title>Department Portal | Smart Gov</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="../Styles/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="Form1" runat="server">
        <aside class="sidebar dept">
            <div class="sidebar-header" style="padding: 0 1rem; margin-bottom: 2rem;">
                <h2 style="color: #10b981; border-left: 4px solid #10b981; padding-left: 12px; letter-spacing: 1px;">
                    <i class="fas fa-building"></i> DEPT PANEL
                </h2>
            </div>

            <nav class="nav-menu">
                <asp:HyperLink ID="lnkDash" runat="server" NavigateUrl="~/Department/Dashboard.aspx" CssClass="nav-link">
                    <i class="fas fa-chart-line"></i> Dashboard
                </asp:HyperLink>

                <asp:HyperLink ID="lnkPending" runat="server" NavigateUrl="~/Department/PendingComplaints.aspx" CssClass="nav-link">
                    <i class="fas fa-tasks"></i> Pending Tasks
                </asp:HyperLink>

                <asp:HyperLink ID="lnkHistory" runat="server" NavigateUrl="~/Department/ComplaintHistory.aspx" CssClass="nav-link">
                    <i class="fas fa-archive"></i> Resolution History
                </asp:HyperLink>
            </nav>

            <div style="margin-top: auto; padding: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                <asp:HyperLink ID="lnkLogout" runat="server" NavigateUrl="~/Logout.aspx" CssClass="nav-link" style="color: #94a3b8;">
                    <i class="fas fa-sign-out-alt"></i> Sign Out
                </asp:HyperLink>
            </div>
        </aside>

        <main class="main-wrapper">
            <header class="top-bar">
                <div>
                    <h1 style="font-size: 1.25rem; font-weight: 600; color: #1e293b; margin: 0;">Service Management</h1>
                    <small style="color: #64748b;">Departmental Action Center</small>
                </div>
                <div class="dept-badge" style="background: #ecfdf5; color: #065f46; padding: 8px 16px; border-radius: 30px; font-size: 0.85rem; font-weight: 600; border: 1px solid #d1fae5;">
                    <i class="fas fa-check-circle" style="margin-right: 6px;"></i> Operations Active
                </div>
            </header>

            <div class="content-card">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
            
            <footer style="margin-top: 2rem; text-align: center; color: #94a3b8; font-size: 0.75rem;">
                Smart Gov Management System &bull; Internal Departmental Access
            </footer>
        </main>
    </form>
</body>
</html>