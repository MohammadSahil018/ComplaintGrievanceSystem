<%@ Master Language="C#" AutoEventWireup="true" CodeFile="CommonMaster.master.cs" Inherits="Masters_CommonMaster" %>
<!DOCTYPE html>
<html>
<head id="Head1" runat="server">
    <title>View Details</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="../Styles/Site.css" rel="stylesheet" type="text/css" />
</head>
<body style="display: block; background: #f1f5f9;">
    <form id="Form1" runat="server" style="display: block;">
        <div style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <a href="javascript:history.back()" style="text-decoration:none; color: #64748b; font-weight: 600;">
                    <i class="fas fa-arrow-left"></i> Return to List
                </a>
                <asp:HyperLink ID="HyperLink1" NavigateUrl="~/Logout.aspx" runat="server" style="color: #ef4444; text-decoration: none;">Logout</asp:HyperLink>
            </div>
            <div class="content-card">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>
    </form>
</body>
</html>